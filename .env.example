# Application Environment Configuration
NODE_ENV=development
APP_PORT=3000

# Database Configuration (SQLite Local Path)
DB_FILENAME=cosmetics_pos.db
DB_BACKUP_DIR=backups

# Store Default Settings
STORE_NAME=محل مستحضرات التجميل
RECEIPT_PRINTER_WIDTH=80mm
ENABLE_DRAWER_AUTO_OPEN=true
SESSION_TIMEOUT_MINUTES=5

# Admin Accounts Credentials (Optional overrides - defaults exist for dev)
ADMIN_OWNER_PASSWORD=
ADMIN_OWNER_PIN=
ADMIN_TEST_PASSWORD=
ADMIN_TEST_PIN=
